{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "jest", "aws-lambda"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts", "**/__tests__/**", "dist"]
}

